# Copy to config/.env and fill in. NEVER commit the real .env (see .gitignore).
# Loaded by core.config via python-dotenv.

# FRED (macro series). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Telegram bot for alerts (Phase 3). Not required for Phase 0/1.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override logging level (DEBUG | INFO | WARNING | ERROR).
# Falls back to logging.level in settings.yaml if unset.
LOG_LEVEL=
