# Local override — gitignored, deep-merged OVER config/settings.yaml at load time.
# Put PERSONAL / machine-specific config here so it never enters the public repo.
#
# Usage:
#   cp config/settings.local.yaml.example config/settings.local.yaml
#   # then edit config/settings.local.yaml (only include keys you want to override)
#
# Deep merge: nested dicts merge key-by-key; lists (like manual_holdings) replace
# wholesale. Anything you omit falls through to settings.yaml unchanged.

# Example — record capital the READ-ONLY Binance key cannot see (e.g. Spot Grid bots).
# Each entry is a priced position {asset, amount, note} or a lump sum {label, value_usd, note}.
#
# sources:
#   binance_account:
#     manual_holdings:
#       - {asset: BTC, amount: 0.002, note: "spot grid bot"}
#       - {label: "Trading bots", value_usd: 200, note: "spot grid bots (read-only key can't see)"}

# Cost basis for PnL. Any entry here OVERRIDES the trade-derived average (which only
# sees the last ~180 days) — use it to set your exchange's lifetime average, or to cover
# tokens with no trade records (Convert, wrapped, old buys). Per token, give EITHER:
#   avg_price:    average buy price in USD (cost = avg_price x current amount held), or
#   invested_usd: total USD you put in (used as-is).
# Omit a token to fall back to its trade average (or leave PnL blank if it has no trades).
#
# sources:
#   binance_account:
#     cost_basis:
#       XRP:   {avg_price: 0.52}
#       WBETH: {invested_usd: 100}
#       BNB:   {avg_price: 600}

# FX rates (currency -> USD) to value non-USD fiat deposits/withdrawals for "net capital
# deployed". USD is assumed 1.0. A currency without a rate is counted but not summed.
#
# sources:
#   binance_account:
#     fx_to_usd:
#       COP: 0.00024   # ~1 USD ≈ 4100 COP; ajusta al valor actual
